[Unit]
Description=jap-tailscale: Tailscale in userspace networking, SOCKS5 on 127.0.0.1:1065 for Moonride's relay
After=network.target mgu-uplink.service

[Service]
ExecStartPre=/bin/sh /var/opt/jap-tailscale/current/setup.sh
# resolv.conf (kept by run.sh from the uplink lease) over /etc/resolv.conf in a mount namespace of this unit's own;
# the namespace's mounts are made private first, so the bind never propagates to the rest of the system (and is
# skipped if they cannot be);
# then root is dropped to uid 3920 (component.json "uids": the uplink routes it), which has no account
ExecStart=/usr/bin/unshare -m /bin/sh -c '{ mount --make-rprivate / && mount --bind /run/jap-tailscale/resolv.conf /etc/resolv.conf; } || echo "jap-tailscale: resolv.conf not bound" >&2; exec /var/opt/jap-tailscale/current/jap-runas 3920 /var/opt/jap-tailscale/current/run.sh'
Restart=always
RestartSec=10
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
