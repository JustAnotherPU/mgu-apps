{
  "id": "jap-tailscale",
  "kind": "tool",
  "version": "1.104.4",
  "license": "BSD-3-Clause AND GPL-3.0-or-later",
  "title": "Tailscale",
  "description": "Tailscale 1.104.4 (built from the upstream tag) in userspace networking, with a SOCKS5 server on 127.0.0.1:1065 that programs on the head unit (Moonride's relay) use to reach your tailnet; incoming tailnet connections refused (shields up); Moonride shows the login link as a QR code; source: https://github.com/JustAnotherPU/mgu-apps",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "internet": true,
  "uids": [
    3920
  ],
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "tailscaled",
      "from": "build/tailscaled",
      "mode": "0755"
    },
    {
      "path": "jap-runas",
      "from": "build/jap-runas",
      "mode": "0755"
    },
    {
      "path": "LICENSE",
      "from": "build/LICENSE",
      "mode": "0644"
    },
    {
      "path": "COPYING",
      "from": "COPYING",
      "mode": "0644"
    },
    {
      "path": "run.sh",
      "from": "run.sh",
      "mode": "0755"
    },
    {
      "path": "setup.sh",
      "from": "setup.sh",
      "mode": "0755"
    },
    {
      "path": "jap-ts",
      "from": "jap-ts",
      "mode": "0755"
    },
    {
      "path": "check.sh",
      "from": "check.sh",
      "mode": "0755"
    }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    {
      "name": "jap-tailscale.service",
      "from": "systemd/jap-tailscale.service"
    }
  ],
  "enable": [
    {
      "unit": "jap-tailscale.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "jap-tailscale"
  ],
  "restart": [
    "jap-tailscale.service"
  ]
}
