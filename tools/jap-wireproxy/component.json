{
  "id": "jap-wireproxy",
  "kind": "tool",
  "version": "1.1.3",
  "license": "ISC AND MIT AND Apache-2.0 AND BSD-3-Clause AND GPL-3.0-or-later",
  "title": "wireproxy",
  "description": "A client for the WireGuard® protocol to your own server (no account, no relay): wireproxy v1.1.3-mgu2 in userspace, with SOCKS5 on 127.0.0.1 for programs on the head unit; picks the endpoint, MTU and TCP send buffer from the uplink (home Wi-Fi or mobile); does nothing until you write its configuration; source: https://github.com/JustAnotherPU/mgu-apps",
  "requires": {
    "mgu-deploy": "0.7.0"
  },
  "uninstallable": true,
  "internet": true,
  "uids": [
    3921
  ],
  "mguHmi": [
    "ID7"
  ],
  "files": [
    {
      "path": "wireproxy",
      "from": "build/wireproxy",
      "mode": "0755"
    },
    {
      "path": "jap-runas",
      "from": "build/jap-runas",
      "mode": "0755"
    },
    {
      "path": "LICENSE.wireproxy",
      "from": "build/LICENSE.wireproxy",
      "mode": "0644"
    },
    {
      "path": "LICENSE.wireguard-go",
      "from": "build/LICENSE.wireguard-go",
      "mode": "0644"
    },
    {
      "path": "LICENSES.txt",
      "from": "build/LICENSES.txt",
      "mode": "0644"
    },
    {
      "path": "COPYING.jap-runas",
      "from": "build/COPYING.jap-runas",
      "mode": "0644"
    },
    {
      "path": "start.sh",
      "from": "start.sh",
      "mode": "0755"
    },
    {
      "path": "setup.sh",
      "from": "setup.sh",
      "mode": "0755"
    },
    {
      "path": "resolve.js",
      "from": "resolve.js",
      "mode": "0644"
    },
    {
      "path": "check.sh",
      "from": "check.sh",
      "mode": "0755"
    }
  ],
  "check": [
    "check.sh"
  ],
  "units": [
    {
      "name": "jap-wireproxy.service",
      "from": "systemd/jap-wireproxy.service"
    }
  ],
  "enable": [
    {
      "unit": "jap-wireproxy.service",
      "target": "multi-user.target"
    }
  ],
  "recmgr": [
    "jap-wireproxy"
  ],
  "restart": [
    "jap-wireproxy.service"
  ]
}
